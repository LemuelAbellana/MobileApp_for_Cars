{
  "expo": {
    "name": "Cardesk",
    "slug": "Cardesk",
    "version": "1.0.0",
    "scheme": "Cardesk",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-status-bar",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.Cardesk.inventory"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
